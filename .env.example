# Domain Name managed by Cloudflare (used for automated domain scoping)
DOMAIN_NAME=yourdomain.com

# Cloudflare Configuration
# Provide your Cloudflare API Token below (Permissions: Zone:Read, Zone:DNS:Edit, Account:Tunnel:Edit):
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_TUNNEL_NAME=cf-docker-tunnel-sync
# Optional: Auto-detected from zone if left empty
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Network & Multi-Stack Configuration
# If running multiple stacks on the same Docker host, change this network name per stack:
CF_NETWORK_NAME=cf-tunnel-net

# Host Binding & Dashboard Configuration
DASHBOARD_PORT=8080
DASHBOARD_BIND_ADDRESS=0.0.0.0

# Embedded Web Dashboard Authentication
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose_a_long_random_password
# Backward-compatible aliases:
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=choose_a_long_random_password

# Protocol & Network Settings (Optional)
# CLOUDFLARED_PROTOCOL=auto       # Options: auto, http2, quic (use http2 if UDP port 7844 is blocked)
# LOG_LEVEL=INFO                  # Options: DEBUG, INFO, WARNING, ERROR
# DOCKER_SOCKET=/var/run/docker.sock # Path to Docker daemon socket (alias: DOCKER_SOCKET_PATH)
# REQUIRE_SHARED_NETWORK=false    # Exclude containers from sync if they do not share a network with cloudflared

# Event-Driven Synchronization & Debounce (Optional)
# SYNC_DEBOUNCE_SECONDS=2.5       # Debounce window in seconds to coalesce rapid container churn (alias: SYNC_DEBOUNCE_DELAY)
# SYNC_DEBOUNCE_MAX_DELAY=10.0     # Maximum debounce delay before forcing a sync run
# SYNC_FALLBACK_INTERVAL=900      # Periodic fallback heartbeat sync in seconds (alias: SYNC_INTERVAL, POLL_INTERVAL)

# DNS Tombstoning & Grace Period (Optional)
# DNS_CLEANUP_GRACE_PERIOD=300   # Seconds to retain DNS records before deletion after container stops (default: 5m)
# DNS_IMMEDIATE_CLEANUP=false    # Set to true to bypass tombstone grace period and delete records immediately
