# Domain Name managed by Cloudflare (used for automated domain scoping)
DOMAIN_NAME=yourdomain.com

# Cloudflare Configuration
# Provide your Cloudflare API Token below:
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_TUNNEL_NAME=cf-docker-tunnel-sync
# Optional: Auto-detected from zone if left empty
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Network & Multi-Stack Configuration
# If running multiple tunnel stacks on the same Docker host (e.g. for different accounts):
# Change the network name and tunnel name for each stack.
# CF_NETWORK_NAME=cf-tunnel-net
# CLOUDFLARED_CONTAINER_NAME=cloudflared
# CLOUDFLARED_PROTOCOL=auto # Options: auto, http2, quic (use http2 if UDP port 7844 is blocked)


# Dashboard access. Set DASHBOARD_AUTH_ENABLED=false only on a trusted network.
DASHBOARD_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=choose_a_username
BASIC_AUTH_PASSWORD=choose_a_long_random_password

# Optional dashboard host binding (0.0.0.0 makes it reachable on your LAN).
# For multi-stack setups, assign different host ports (e.g., 8080, 8081).
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8080

# Docker Socket & Event Sync Tuning (Optional)
# DOCKER_TIMEOUT=10
# DOCKER_RETRIES=3
# SYNC_DEBOUNCE_DELAY=2.5
# SYNC_FALLBACK_INTERVAL=900
# DNS Tombstoning & Grace Period (Optional)
# DNS_CLEANUP_GRACE_PERIOD=300   # Seconds to keep DNS records before deletion after container stops (default: 5m)
# DNS_IMMEDIATE_CLEANUP=false    # Set to true to bypass tombstone grace period and delete records immediately
# Docker Network Diagnostics (Optional)
# REQUIRE_SHARED_NETWORK=false    # Exclude containers from sync if they do not share a network with cloudflared
