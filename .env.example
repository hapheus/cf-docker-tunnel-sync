# ==============================================================================
# CF-DOCKER-TUNNEL-SYNC CONFIGURATION
# ==============================================================================
# For most deployments, only THE ESSENTIAL THREE values below are required.
# Everything else has production-ready defaults and automatic discovery.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THE ESSENTIAL THREE (MANDATORY)
# ------------------------------------------------------------------------------

# Cloudflare API Token (Permissions: Account:Cloudflare Tunnel:Edit, Zone:DNS:Edit, Zone:Zone:Read)
# Legacy alias: CLOUDFLARE_TOKEN
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Name of your Cloudflare Tunnel (auto-created if it does not exist)
# Can alternatively be an existing tunnel UUID via CLOUDFLARE_TUNNEL_ID
# Legacy alias: TUNNEL_NAME
CLOUDFLARE_TUNNEL_NAME=cf-docker-tunnel-sync

# Primary domain/zone managed by Cloudflare (e.g., example.com)
DOMAIN_NAME=yourdomain.com

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE ACCOUNT PINNING (OPTIONAL)
# ------------------------------------------------------------------------------
# Auto-discovered automatically from your domain zone or API token.
# Specify ONLY if your API token has access to multiple Cloudflare accounts and
# you need to pin synchronization to a specific account.
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
# CLOUDFLARE_ZONE_ID=your_zone_id_here  # Optional: auto-discovered from DOMAIN_NAME

# ------------------------------------------------------------------------------
# 3. DOCKER & NETWORK ROUTING (OPTIONAL)
# ------------------------------------------------------------------------------
# Docker bridge network connecting cloudflared, cf-tunnel-sync, and target services.
CF_NETWORK_NAME=cf-tunnel-net

# Path to Docker daemon socket or TCP URL (e.g., tcp://socket-proxy:2375)
# Legacy alias: DOCKER_SOCKET_PATH
# DOCKER_SOCKET=/var/run/docker.sock

# Container name of the cloudflared daemon container
# CLOUDFLARED_CONTAINER_NAME=cloudflared

# Exclude containers that do not share a network with cloudflared (default: false)
# REQUIRE_SHARED_NETWORK=false

# ------------------------------------------------------------------------------
# 4. SAFETY GUARDS & BLAST-RADIUS CIRCUIT BREAKERS (OPTIONAL)
# ------------------------------------------------------------------------------
# Maximum route/DNS deletions permitted in a single sync run (protects against accidental mass removal)
# Legacy aliases: MASS_DELETION_LIMIT, MAX_DELETIONS_THRESHOLD, MAX_DELETIONS_PER_RUN
MAX_DELETIONS_PER_SYNC=3

# Maximum percentage of routes that can be deleted in one cycle (e.g. 0.50 = 50%)
# MAX_DELETION_RATIO=0.50

# Circuit breaker override (set to true only for deliberate mass service teardown)
ALLOW_MASS_DELETIONS=false

# Seconds to retain DNS records for stopped containers before removal (tombstone grace period)
DNS_CLEANUP_GRACE_PERIOD=300

# Immediate cleanup without grace period (default: false)
# DNS_IMMEDIATE_CLEANUP=false

# ------------------------------------------------------------------------------
# 5. SYNCHRONIZATION & DEBOUNCE (OPTIONAL)
# ------------------------------------------------------------------------------
# Stabilization window in seconds to coalesce rapid container churn
# Legacy aliases: DEBOUNCE_WAIT_SECONDS, DEBOUNCE_SECONDS, SYNC_DEBOUNCE_DELAY
SYNC_DEBOUNCE_SECONDS=2.5
SYNC_DEBOUNCE_MAX_DELAY=10.0

# Heartbeat fallback sync interval in seconds
# Legacy aliases: SYNC_INTERVAL, POLL_INTERVAL, FALLBACK_INTERVAL
SYNC_FALLBACK_INTERVAL=900

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & WEB DASHBOARD (OPTIONAL)
# ------------------------------------------------------------------------------
# Internal dashboard port (typically mapped to host 8080)
DASHBOARD_PORT=8090
DASHBOARD_BIND_ADDRESS=0.0.0.0

# Embedded Web Dashboard Authentication (HTTP Basic Auth)
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose_a_long_random_password

# Backward-compatible authentication aliases:
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=choose_a_long_random_password

# Prometheus metrics authentication (default: false for unauthenticated scrape compatibility)
METRICS_AUTH_ENABLED=false

# Logging verbosity and format (LOG_FORMAT: text or json)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Operational webhook alert notifications (Slack / Discord / generic incoming webhook)
# NOTIFICATION_WEBHOOK_URL=https://discord.com/api/webhooks/...
