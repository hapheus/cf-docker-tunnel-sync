# Domain managed by Cloudflare
DOMAIN_NAME=example.com

# Cloudflare API Token (Permissions needed: Zone:Read, Zone:DNS:Edit, Account:Tunnel:Edit)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_TUNNEL_NAME=single-stack-tunnel

# Optional: Cloudflare Account ID (auto-discovered from domain if omitted)
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Embedded Web Dashboard Authentication
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
# REQUIRED if DASHBOARD_AUTH_ENABLED=true.
# NOTE: Missing or empty credentials strictly fail closed with HTTP 401 Unauthorized!
DASHBOARD_PASSWORD=replace_with_a_secure_password
# Backward-compatible aliases:
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=replace_with_a_secure_password

# Web Dashboard Host Port & Protocol Settings (Optional)
DASHBOARD_PORT=8080
# Bind address: 127.0.0.1 (default) limits dashboard to local host / SSH tunnel.
# Set to 0.0.0.0 to expose the dashboard across your local LAN.
DASHBOARD_BIND_ADDRESS=127.0.0.1
# Protocol for cloudflared: 'auto', 'quic', or 'http2' (use 'http2' if UDP port 7844 is blocked)
CLOUDFLARED_PROTOCOL=auto
