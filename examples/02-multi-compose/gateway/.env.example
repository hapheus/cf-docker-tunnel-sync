# Domain managed by Cloudflare
DOMAIN_NAME=example.com

# Cloudflare API Token (Zone:Read, Zone:DNS:Edit, Account:Tunnel:Edit)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_TUNNEL_NAME=gateway-tunnel

# Network Name (default: cf-tunnel-net)
CF_NETWORK_NAME=cf-tunnel-net

# Web Dashboard
DASHBOARD_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=replace_with_a_secure_password
DASHBOARD_PORT=8080
