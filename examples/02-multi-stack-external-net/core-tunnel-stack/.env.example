# Required: replace the token and domain before starting the gateway.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_TUNNEL_NAME=homelab-gateway
DOMAIN_NAME=example.com

# Optional account pinning; forwarded to the sync container when set.
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Use this same network name in the application stack's .env.
CF_NETWORK_NAME=cf-tunnel-net
LOG_LEVEL=INFO

# Used only with docker-compose.with-dashboard.yml.
DASHBOARD_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=replace_with_a_long_random_password
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080
