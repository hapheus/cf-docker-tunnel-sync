# Replace the example domain and token with your personal account's values.
DOMAIN_NAME=example.com
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_TUNNEL_NAME=personal-tunnel
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CF_NETWORK_NAME=cf-tunnel-net-personal
# This name must be unique on the Docker host.
CLOUDFLARED_CONTAINER_NAME=personal-cloudflared
LOG_LEVEL=INFO

# The companion frontend is published locally by this example configuration.
DASHBOARD_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=replace_with_a_long_random_password
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080
