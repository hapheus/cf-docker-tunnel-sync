DOMAIN_NAME=personal.me
CLOUDFLARE_API_TOKEN=personal_cloudflare_token
CLOUDFLARE_TUNNEL_NAME=personal-tunnel
# Optional: explicitly pin account ID if API token has multi-account access
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CF_NETWORK_NAME=cf-tunnel-net-personal
DASHBOARD_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=replace_with_a_secure_password
DASHBOARD_PORT=8080
