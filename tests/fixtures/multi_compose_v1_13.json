{
  "topology": "multi-compose",
  "version_baseline": "v1.13.0",
  "description": "Multi-compose topology: central gateway on cf-tunnel-net and independent service stacks",
  "environment": {
    "CLOUDFLARE_API_TOKEN": "mock-token-v1-13",
    "CLOUDFLARE_ZONE_ID": "mock-zone-id-12345",
    "CLOUDFLARE_TUNNEL_ID": "22222222-3333-4444-5555-666666666666",
    "CLOUDFLARE_TUNNEL_NAME": "edge-gateway",
    "DOMAIN_NAME": "example.com",
    "REQUIRE_SHARED_NETWORK": "false"
  },
  "containers": [
    {
      "Id": "app-container-9988",
      "Names": ["/blog-service"],
      "State": "running",
      "NetworkSettings": {
        "Networks": {
          "cf-tunnel-net": {
            "IPAddress": "172.20.0.5"
          },
          "blog-internal": {
            "IPAddress": "172.21.0.2"
          }
        }
      },
      "Labels": {
        "cf.tunnel.hostname": "blog.example.com",
        "cf.tunnel.port": "2368"
      }
    }
  ],
  "expected_remote_ingress": [
    {
      "hostname": "blog.example.com",
      "service": "http://blog-service:2368"
    },
    {
      "service": "http_status:404"
    }
  ],
  "expected_remote_dns": [
    {
      "id": "rec-dns-002",
      "type": "CNAME",
      "name": "blog.example.com",
      "content": "22222222-3333-4444-5555-666666666666.cfargotunnel.com",
      "proxied": true,
      "comment": "cf-tunnel-sync:edge-gateway"
    }
  ]
}
