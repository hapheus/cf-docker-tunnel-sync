{
  "topology": "single-compose",
  "version_baseline": "v1.13.0",
  "description": "Standard single-compose deployment with cf-docker-tunnel-sync and whoami in the same stack",
  "environment": {
    "CLOUDFLARE_API_TOKEN": "mock-token-v1-13",
    "CLOUDFLARE_ZONE_ID": "mock-zone-id-12345",
    "CLOUDFLARE_TUNNEL_ID": "11111111-2222-3333-4444-555555555555",
    "CLOUDFLARE_TUNNEL_NAME": "homelab-gateway",
    "DOMAIN_NAME": "example.com",
    "REQUIRE_SHARED_NETWORK": "false"
  },
  "containers": [
    {
      "Id": "c1a2b3c4d5e6",
      "Names": ["/whoami-service"],
      "State": "running",
      "NetworkSettings": {
        "Networks": {
          "bridge": {
            "IPAddress": "172.18.0.2"
          }
        }
      },
      "Labels": {
        "cf.tunnel.hostname": "whoami.example.com",
        "cf.tunnel.port": "80"
      }
    }
  ],
  "expected_remote_ingress": [
    {
      "hostname": "whoami.example.com",
      "service": "http://whoami-service:80"
    },
    {
      "service": "http_status:404"
    }
  ],
  "expected_remote_dns": [
    {
      "id": "rec-dns-001",
      "type": "CNAME",
      "name": "whoami.example.com",
      "content": "11111111-2222-3333-4444-555555555555.cfargotunnel.com",
      "proxied": true,
      "comment": "cf-tunnel-sync:homelab-gateway"
    }
  ]
}
